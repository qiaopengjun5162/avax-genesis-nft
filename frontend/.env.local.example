# GenesisMint 前端环境变量（复制为 .env.local 后填值；.env.local 已被 gitignore）

# WalletConnect Cloud project id（RainbowKit 依赖；
# 留空则用本地降级 projectId，部分钱包/弹窗功能受限，仅本地开发可接受）
NEXT_PUBLIC_WC_PROJECT_ID=

# 签名后端地址（默认本地 :8787，对应 backend/ npm start）
NEXT_PUBLIC_SIGNER_URL=http://127.0.0.1:8787

# GenesisMint 合约地址（默认 Fuji 演示实例；换新部署时改这里，前后端要一致）
NEXT_PUBLIC_CONTRACT_ADDRESS=0x7AD0921D80CeFC98889a84B960c74866A452Cc2A
