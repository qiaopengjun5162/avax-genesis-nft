# 签名后端私钥（独立于部署者；本地生成，勿提交 git）
# 该私钥对应地址必须是链上 signer()，否则签出来的名全被拒绝
SIGNER_PRIVATE_KEY=
PORT=8787
# 开发期 CORS 白名单（默认 *；上线改成前端域名）
CORS_ORIGIN=
# 目标合约（留空 = Fuji 演示实例 0x48c9F7B4911Da705BD3285173B333b37CcB4a550）
CONTRACT_ADDRESS=
# 自定义 RPC（公共节点限流时换成自己的）
FUJI_RPC=
# 匿名端点限流（防 RPC/CPU 被刷爆），单位：次 / 窗口
# /sign 每 IP 60s 内最多 30 次；/allowlist 每 IP 60s 内最多 60 次
SIGN_RATE_LIMIT=30
ALLOWLIST_RATE_LIMIT=60
SIGN_RATE_WINDOW_MS=60000
# 签名有效窗口（秒）：防永久有效签名，用户须在此窗口内完成 mint
SIGN_DEADLINE_SECONDS=3600
