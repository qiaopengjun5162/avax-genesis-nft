# 签名后端私钥（独立于部署者；本地生成，勿提交 git）
# 该私钥对应地址必须是链上 signer()，否则签出来的名全被拒绝
SIGNER_PRIVATE_KEY=
PORT=8787
# CORS 允许源：留空 = 不限制（回显 *，本地开发用）；上线填前端域名
# 支持逗号分隔多源；一旦填写，只有命中的 origin 会拿到 ACAO 头
CORS_ORIGIN=
# 是否信任反向代理带来的 X-Forwarded-For（1 = 信任）
# 限流的计数键：不信任时只认真实 TCP 对端（XFF 是客户端可伪造的）
# 部署在 Nginx / LB 后面必须设 1，否则所有请求会被算成代理那一个 IP
TRUST_PROXY=
# 访问日志（每个请求一行 JSON：method/path/status/ms/ip/ua）；设 0 关闭
ACCESS_LOG=1
# 目标合约（留空 = Fuji 演示实例 0x48c9F7B4911Da705BD3285173B333b37CcB4a550）
CONTRACT_ADDRESS=
# 自定义 RPC（公共节点限流时换成自己的）
FUJI_RPC=
# 匿名端点限流（防 RPC/CPU 被刷爆），单位：次 / 窗口
# /sign 每 IP 60s 内最多 30 次；/allowlist 每 IP 60s 内最多 60 次
SIGN_RATE_LIMIT=30
ALLOWLIST_RATE_LIMIT=60
SIGN_RATE_WINDOW_MS=60000
# 签名有效窗口（秒）：防永久有效签名，用户须在此窗口内完成 mint
# 同时是「已签未上链」名额的保留时长——签名过期即释放
SIGN_DEADLINE_SECONDS=3600
# 链上读取兜底超时（毫秒）：RPC 挂起时别把请求吊死、别一直占着钱包锁
RPC_QUERY_TIMEOUT_MS=8000
